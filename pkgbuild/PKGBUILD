pkgname=omagltf
pkgver=0.1.0
pkgrel=1
pkgdesc='Focused GLB, glTF, FBX, and OBJ viewer built with Qt Quick 3D'
arch=('x86_64')
url='https://github.com/nicopellerin/omagltf'
license=('MIT' 'OFL-1.1')
replaces=('omaviewer')
conflicts=('omaviewer')
depends=(
  'assimp'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-quick3d'
  'shared-mime-info'
  'sushi'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make')
install=omagltf.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  local repo_root="$startdir/.."

  install -Dm755 "$repo_root/build/omagltf" \
    "$pkgdir/usr/bin/omagltf"
  install -Dm644 "$repo_root/pkgbuild/omagltf.desktop" \
    "$pkgdir/usr/share/applications/omagltf.desktop"
  install -Dm644 "$repo_root/pkgbuild/omagltf.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omagltf.svg"
  install -Dm644 "$repo_root/pkgbuild/omagltf-mime.xml" \
    "$pkgdir/usr/share/mime/packages/omagltf.xml"
  install -Dm644 "$repo_root/sushi/omagltf.js" \
    "$pkgdir/usr/share/sushi/viewers/omagltf.js"
  install -Dm644 "$repo_root/LICENSE" \
    "$pkgdir/usr/share/licenses/omagltf/LICENSE"
}

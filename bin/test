#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bash -n "$repo_root/bin/build" "$repo_root/bin/run" "$repo_root/bin/install"

if command -v desktop-file-validate >/dev/null 2>&1; then
  desktop-file-validate "$repo_root/pkgbuild/oma3dviewer.desktop"
fi

if command -v xmllint >/dev/null 2>&1; then
  xmllint --noout "$repo_root/src/resources.qrc"
  xmllint --noout "$repo_root/pkgbuild/oma3dviewer-mime.xml"
  xmllint --noout "$repo_root/pkgbuild/oma3dviewer.svg"
fi

if command -v node >/dev/null 2>&1; then
  node --check "$repo_root/sushi/oma3dviewer.js"
fi

test -s "$repo_root/sushi/oma3dviewer.js"

if command -v qmlformat >/dev/null 2>&1; then
  for qml_file in "$repo_root"/src/*.qml; do
    qmlformat "$qml_file" >/dev/null
  done
fi

if pkg-config --exists Qt6Quick3D 2>/dev/null; then
  qmllint -I /usr/lib/qt6/qml "$repo_root"/src/*.qml
  "$repo_root/bin/build"
else
  echo "Skipping QML/build checks: qt6-quick3d is not installed."
fi

echo "Static checks passed."

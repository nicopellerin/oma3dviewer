pkgname=omaviewer
pkgver=0.1.0
pkgrel=1
pkgdesc='Focused GLB, glTF, FBX, and OBJ viewer built with Qt Quick 3D'
arch=('x86_64')
url='https://github.com/nicopellerin/omaviewer'
license=('MIT' 'OFL-1.1')
depends=(
  'assimp'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-quick3d'
  'shared-mime-info'
  'sushi'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make')
install=omaviewer.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  local repo_root="$startdir/.."

  install -Dm755 "$repo_root/build/omaviewer" \
    "$pkgdir/usr/bin/omaviewer"
  install -Dm644 "$repo_root/pkgbuild/omaviewer.desktop" \
    "$pkgdir/usr/share/applications/omaviewer.desktop"
  install -Dm644 "$repo_root/pkgbuild/omaviewer.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaviewer.svg"
  install -Dm644 "$repo_root/pkgbuild/omaviewer-mime.xml" \
    "$pkgdir/usr/share/mime/packages/omaviewer.xml"
  install -Dm644 "$repo_root/sushi/omaviewer.js" \
    "$pkgdir/usr/share/sushi/viewers/omaviewer.js"
  install -Dm644 "$repo_root/LICENSE" \
    "$pkgdir/usr/share/licenses/omaviewer/LICENSE"
  install -Dm644 "$repo_root/THIRD_PARTY_LICENSES/JetBrainsMonoNerd-OFL.txt" \
    "$pkgdir/usr/share/licenses/omaviewer/JetBrainsMonoNerd-OFL.txt"
}
